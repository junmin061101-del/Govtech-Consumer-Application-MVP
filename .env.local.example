# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr). 비워두면 5건짜리 sample 키로 동작합니다.
SEOUL_OPEN_API_KEY=

# 카카오 developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼(Web) 사이트 도메인에 http://localhost:3000 과 Vercel 배포 도메인을 등록해야 합니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# --- 리뷰·로그인 (없으면 리뷰 기능만 '곧 열려요'로 표시됩니다) ---
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) > SDK 설정
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 (JSON 전체를 base64 로 넣는 것을 권장)
FIREBASE_SERVICE_ACCOUNT=
# 카카오 developers > 앱 키 > REST API 키 (카카오 로그인 활성화, Redirect URI 등록 필요)
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 사용 중일 때만
KAKAO_CLIENT_SECRET=
