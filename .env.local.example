# ===== 웹 앱 (공개값, 빌드에 포함) =====
# 로컬 개발: 에뮬레이터를 쓰면 아래 Firebase 값은 비워도 된다 (demo-careos 프로젝트로 동작)
NEXT_PUBLIC_USE_EMULATORS=true
# Codespaces 처럼 브라우저가 Auth 에뮬레이터(9099)에 직접 못 닿으면 same-origin (개발 서버가 중계)
NEXT_PUBLIC_AUTH_EMULATOR_URL=

# 카카오 developers > 앱 키 > JavaScript 키 (지도·장소 검색. 사이트 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹). dev/prod 값은 GitHub Environments vars 로 CI 에 넣는다
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# App Check (reCAPTCHA Enterprise 사이트 키). dev 에서 디버그 토큰을 쓰려면 NEXT_PUBLIC_APP_CHECK_DEBUG=true
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_APP_CHECK_DEBUG=

# ===== 서버 비밀값은 여기 두지 않는다 =====
# 배포: Secret Manager (firebase functions:secrets:set <이름>)
# 에뮬레이터: functions/.secret.local (npm run dev:emulators 가 자리표시로 만들어 준다)
#   PKEY_SECRET, NICKNAME_SECRET,
#   SEOUL_OPEN_API_KEY, DATA_GO_KR_SERVICE_KEY  (AI 는 Vertex AI Gemini 를 서비스 계정으로 호출 — 키 없음)
# 서버 설정(비밀 아님)은 functions/.env.<프로젝트ID> 에 둔다: ADMIN_EMAILS, ADMIN_UIDS, APP_CHECK_ENFORCE, LLM_MODEL, SEOUL_CHILDCARE_SERVICES
